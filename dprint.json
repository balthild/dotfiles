{
	"excludes": [
		"!.vscode/*.json",
		"!.dotter/*.toml",
		"other/feishin-settings.json",
	],

	"useTabs": true,
	"indentWidth": 2,
	"lineWidth": 100,

	"json": {
		"trailingCommas": "jsonc",
		"jsonTrailingCommaFiles": [
			"dprint.json",
			".vscode/*.json",
		],
	},

	"toml": {
		"indentTables": "never",
		"indentEntries": "never",
	},

	"malva": {
		"useTabs": true,
		"indentWidth": 2,
		"quotes": "preferDouble",
	},

	"yaml": {
		"quotes": "preferDouble",
		"braceSpacing": true,
		"bracketSpacing": true,
		"formatComments": true,
	},

	"markdown": {
		"textWrap": "never",
		"table.cellPadding": "align",
	},

	"clangFormat": {
		"BasedOnStyle": "LLVM",
		"AccessModifierOffset": -2,
		"AlignAfterOpenBracket": "BlockIndent",
		"AllowAllArgumentsOnNextLine": false,
		"AllowAllParametersOfDeclarationOnNextLine": false,
		"AllowShortEnumsOnASingleLine": false,
		"AllowShortFunctionsOnASingleLine": "Empty",
		"AlwaysBreakTemplateDeclarations": "Yes",
		"BinPackArguments": false,
		"BinPackParameters": false,
		"ContinuationIndentWidth": 2,
		"Cpp11BracedListStyle": false,
		"InsertNewlineAtEOF": true,
		"PackConstructorInitializers": "CurrentLine",
		"QualifierAlignment": "Left",
		"PointerAlignment": "Left",
		"ReflowComments": "Always",
		"SpaceAfterCStyleCast": true,
		"SpaceBeforeCpp11BracedList": true,
		"TabWidth": 2,
	},

	"plugins": [
		"npm:@dprint/json@0.26.0",
		"npm:@dprint/toml@0.10.0",
		"npm:@dprint/stylua@0.2.0",
		"npm:@dprint/markdown@0.29.0",
		"npm:@dprint/clang-format@0.3.2",
		"npm:dprint-plugin-malva@0.16.1",
		"npm:dprint-plugin-yaml@0.6.0",
	],
}
