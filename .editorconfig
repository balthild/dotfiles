root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[**.{md,nix,yml,yaml}]
indent_style = space
indent_size = 2

[**.{nix,fish,elv,nu,js,lua,rb,pl,css,toml,json,jsonc}]
indent_style = tab
indent_size = 2

[.gitconfig]
indent_style = tab
indent_size = 2
